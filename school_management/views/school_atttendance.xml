<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="school_attendance_view_form" model="ir.ui.view">
        <field name="name">school.attendance.view.form</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <form string="school_attendance">
                <sheet>
                    <group>
                        <field name="date"/>
                        <field name="timetable_id"/>
                        <field name="timetable_line"/>
                    </group>

                    <notebook>
                        <page string="Attendance">
                            <field name="attendance_line_ids">
                                <list editable="bottom">
                                    <field name="student_enroll"/>
                                    <field name="att_status"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- List View -->
    <record id="school_attendance_view_list" model="ir.ui.view">
        <field name="name">school.attendance.view.list</field>
        <field name="model">school.attendance</field>
        <field name="arch" type="xml">
            <list string="school_attendance">
               <field name="date"/>
                <field name="timetable_id"/>
                <field name="timetable_line"/>
            </list>
        </field>
    </record>
    
    <!-- Action -->
    <record id="school_attendance_action" model="ir.actions.act_window">
        <field name="name">School attendance</field>
        <field name="res_model">school.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first school attendance!
            </p>
        </field>
    </record>
    
    <!-- Menu -->
    <menuitem id="school_attendance_menu"
              name="School attendance"
               parent="school_root_menu"
              action="school_attendance_action"
              sequence="4"/>
</odoo>