<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List View -->
    <record id="school_student_view_list" model="ir.ui.view">
        <field name="name">school.student.list</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_number"/>
                <field name="full_name"/>
                <field name="gender"/>
                <field name="phone"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="school_student_view_form" model="ir.ui.view">
    <field name="name">school.student.form</field>
    <field name="model">school.student</field>
    <field name="arch" type="xml">
        <form string="Student">

            <sheet>

                <!-- Header -->
                <div class="oe_title">
                    <h1>
                        <field name="full_name" readonly="1" placeholder="Student Name"/>
                    </h1>
                    <field name="image"
                           widget="image"
                           class="oe_avatar"
                           nolabel="1"
                           options="{'size':[180,180]}"/>
                </div>



                <group>

                    <!-- Left Side -->
                    <group>
                        <group string="personal info">
                            <field name="first_name"/>
                            <field name="last_name"/>
                            <field name="gender"/>
                            <field name="date_of_birth"/>
                            <field name="age" readonly="1"/>
                            <field name ="habbit"/>
                            <field name="color_eyes"/>
                        </group>
                        <group string="school info">
                            <field name="student_number" readonly="1"/>
                            <field name="status"/>
                            <field name="admission_date"/>
                        </group>
                    </group>

                    <!-- Right Side -->
                    <group>

                    </group>

                </group>

                <notebook>

                    <page string="Contact">
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="address"/>
                        </group>
                    </page>

                    <page string="Parent">
                        <group>
                            <field name="parent_name"/>
                            <field name="parent_phone"/>
                            <field name="emergency_contact"/>
                        </group>
                    </page>

                    <page string="Notes">
                        <field name="notes"/>
                    </page>

                </notebook>

            </sheet>

        </form>
    </field>
</record>

    <!-- Search View -->
    <record id="school_student_view_search" model="ir.ui.view">
        <field name="name">school.student.search</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_number"/>
                <field name="full_name"/>
                <field name="phone"/>
            </search>
        </field>
    </record>
 <!-- Root Menu -->
    <menuitem
        id="school_root_menu"
        name="School Management"
        sequence="0"/>

    <!-- Action -->
    <record id="school_student_action" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Students Menu -->
    <menuitem
        id="school_student_menu"
        name="Students"
        parent="school_root_menu"
        action="school_student_action"
        sequence="1"/>
</odoo>