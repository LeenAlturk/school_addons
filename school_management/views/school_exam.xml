<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="school_exam_view_form" model="ir.ui.view">
        <field name="name">school.exam.view.form</field>
        <field name="model">school.exam</field>
        <field name="arch" type="xml">
            <form string="School_exam">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="exam_type"/>
                        <field name="class_id"/>
                        <field name="subject"/>
                        <field name="acadimic_year_id"/>
                        <field name="exam_date"/>
                        <field name="max_mark"/>
                        <notebook>
                            <page string="Question">
                                <field name="question_ids">
                                    <list>
                                        <field name="question_num"/>
                                        <field name="question"/>
                                        <field name="answer_type"/>
                                        <field name="mark_question"/>
                                        <field name="choices_ids" invisible="answer_type != 'multiple_Select'" widget="many2many_tags"/>
                                    </list>
                                        <form>
                                        <group>
                                            <field name="exam_id" invisible="1"/>
                                        <field name="question_num"/>
                                        <field name="question"/>
                                        <field name="answer_type"/>
                                        <field name="mark_question"/>
                                        <field name="choices_ids"
                                               invisible="answer_type != 'multiple_Select'">
                                            <list>
                                                    <field name="question_id" invisible="1"/>
                                                   <field name="choice"/>
                                                    <field name="is_correct"/>

                                            </list>
                                            <form>
                                                   <group>
                                                        <field name="question_id" invisible="1"/>
                                                   <field name="choice"/>
                                                    <field name="is_correct"/>
                                                   </group>

                                            </form>
                                        </field>
                                        </group>
                                    </form>
                                </field>
                            </page>
                            <page string="Results">
                                <field name="results_ids">
                                    <list>
                                        <field name="student_enroll"/>
                                        <field name="total_mark"/>
                                        <field name="note"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- List View -->
    <record id="school_exam_view_list" model="ir.ui.view">
        <field name="name">school.exam.view.list</field>
        <field name="model">school.exam</field>
        <field name="arch" type="xml">
            <list string="School_exam">
                        <field name="name"/>
                        <field name="exam_type"/>
                        <field name="class_id"/>
                        <field name="acadimic_year_id"/>
                        <field name="subject"/>
                        <field name="exam_date"/>
                        <field name="max_mark"/>
            </list>
        </field>
    </record>
    
    <!-- Action -->
    <record id="school_exam_action" model="ir.actions.act_window">
        <field name="name">School exam</field>
        <field name="res_model">school.exam</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first school exam!
            </p>
        </field>
    </record>


    <menuitem id="school_management_menu_root_exam" name="Exams And Result" parent="school_root_menu" sequence="5"/>
    <!-- Menu -->
    <menuitem id="school_exam_menu"
              parent="school_management_menu_root_exam"
              name="School exam"
              action="school_exam_action"
              sequence="0"/>
</odoo>