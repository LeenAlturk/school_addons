<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="academic_year_view_view_form" model="ir.ui.view">
        <field name="name">academic.year.view.view.form</field>
        <field name="model">academic.year</field>
        <field name="arch" type="xml">
           <form string="Academic Year">
    <header>
        <button name="button_in_active"
                string="Active"
                type="object"
                class="oe_highlight"
                invisible="state != 'draft'"/>

        <button name="button_in_closed"
                string="Close"
                type="object"
                invisible="state != 'active'"/>

        <field name="state"
               widget="statusbar"
               statusbar_visible="draft,active,closed"/>
    </header>

    <sheet>

        <div class="oe_title">
            <h1>
                <field name="name"
                       readonly="1"
                       nolabel="1"
                       placeholder="Academic Year"/>
            </h1>
        </div>

        <group>
            <field name="start_date"/>
            <field name="end_date"/>
            <field name="active"/>
        </group>

    </sheet>
</form>
        </field>
    </record>
    
    <!-- List View -->
    <record id="academic_year_view_view_list" model="ir.ui.view">
        <field name="name">academic.year.view.view.list</field>
        <field name="model">academic.year</field>
        <field name="arch" type="xml">
            <list string="Academic_year_view">
                  <field name="name"/>
                  <field name="start_date"/>
                  <field name="end_date"/>
                  <field name="active"/>
            </list>
        </field>
    </record>
    
    <!-- Action -->
    <record id="academic_year_view_action" model="ir.actions.act_window">
        <field name="name">Academic year view</field>
        <field name="res_model">academic.year</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first academic year !
            </p>
        </field>
    </record>
    
    <!-- Menu -->
    <menuitem id="academic_year_view_menu"
              name="Academic year "
              action="academic_year_view_action"
              parent = "configration_root_menu"
              sequence="3"/>
</odoo>