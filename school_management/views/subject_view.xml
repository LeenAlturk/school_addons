<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="subject_view_view_form" model="ir.ui.view">
        <field name="name">subject.view.view.form</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">
            <form string="Subject_view">
                <sheet>
                   <group >
                       <field name="name" string="Subject Name"/>
                    <field name="code" string="Code"/>
                    <field name="credit_hours" string="Credit Hours"/>
                    <field name="description" string="description"/>
                   </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="subject_view_view_list" model="ir.ui.view">
        <field name="name">subject.view.view.list</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">
            <list string="Subject_view">
                <field name="name" string="Subject Name"/>
                <field name="code" string="Code"/>
                <field name="credit_hours" string="Credit Hours"/>
                <field name="description" string="description"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="subject_view_view_search" model="ir.ui.view">
        <field name="name">subject.view.view.search</field>
        <field name="model">school.subject</field>
        <field name="arch" type="xml">
            <search string="Search Subject_view">
               <field name="name" string="Subject Name"/>
                    <field name="code" string="Code"/>
                    <field name="credit_hours" string="Credit Hours"/>
                    <field name="description" string="description"/>


            </search>
        </field>
    </record>


    <!-- Actions -->
    <record id="subject_view_action" model="ir.actions.act_window">
        <field name="name">Subject view</field>
        <field name="res_model">school.subject</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="subject_view_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first subject view!
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="subject_view_menu"
              name="Subject"
              parent = "configration_root_menu"
              action="subject_view_action"
              sequence="2"/>
</odoo>