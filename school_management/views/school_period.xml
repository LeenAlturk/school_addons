<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="school_period_view_form" model="ir.ui.view">
        <field name="name">school.period.view.form</field>
        <field name="model">school.period</field>
        <field name="arch" type="xml">
            <form string="School period">
                <sheet>
                    <group>
                        <field name="sequence"/>
                        <field name="name"/>
                        <field name="start_time"/>
                        <field name="end_time"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- List View -->
    <record id="school_period_view_list" model="ir.ui.view">
        <field name="name">school.period.view.list</field>
        <field name="model">school.period</field>
        <field name="arch" type="xml">
            <list string="School period">
                 <field name="sequence"/>
                <field name="name"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="school_period_view_search" model="ir.ui.view">
        <field name="name">school.period.view.search</field>
        <field name="model">school.period</field>
        <field name="arch" type="xml">
            <search string="Search Period">
                <field name="name"/>
                <field name="sequence"/>
                <filter string="Active"
                        name="active"
                        domain="[('active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status"
                            name="group_status"
                            context="{'group_by':'active'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Action -->
    <record id="school_period_action" model="ir.actions.act_window">
        <field name="name">School period</field>
        <field name="res_model">school.period</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first school period!
            </p>
        </field>
    </record>
    
    <!-- Menu -->
    <menuitem id="school_period_menu"
              name="School period"
              parent = "configration_root_menu"
              action="school_period_action"
              sequence="10"/>
</odoo>