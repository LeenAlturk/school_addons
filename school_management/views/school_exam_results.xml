<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="school_exam_results_view_form" model="ir.ui.view">
        <field name="name">school.exam.results.view.form</field>
        <field name="model">school.exam.results</field>
        <field name="arch" type="xml">
            <form string="School_exam_results">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="class_id"/>
                        <field name="section"/>
                        <field name="exam_id"/>
                        <field name="student_enroll"/>
                        <field name="total_mark"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- List View -->
    <record id="school_exam_results_view_list" model="ir.ui.view">
        <field name="name">school.exam.results.view.list</field>
        <field name="model">school.exam.results</field>
        <field name="arch" type="xml">
            <list string="School_exam_results">
                        <field name="name"/>
                        <field name="class_id"/>
                        <field name="section"/>
                        <field name="exam_id"/>
                        <field name="student_enroll"/>
                        <field name="total_mark"/>
            </list>
        </field>
    </record>
    
    <!-- Action -->
    <record id="school_exam_results_action" model="ir.actions.act_window">
        <field name="name">School exam results</field>
        <field name="res_model">school.exam.results</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first school exam results!
            </p>
        </field>
    </record>
    
    <!-- Menu -->
    <menuitem id="school_exam_results_menu"
              name="School exam results"
              action="school_exam_results_action"
              sequence="10"/>
</odoo>