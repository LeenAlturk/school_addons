<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="school_enrollment_view_form" model="ir.ui.view">
        <field name="name">school.enrollment.view.form</field>
        <field name="model">enrollment</field>
        <field name="arch" type="xml">
            <form string="School_enrollment">
                <sheet>
                    <group string ="Enrollment Information">
                        <field name="student_id"/>
                         <field name="class_id"/>
                        <field name="section_class_section"/>
                        <field name="academic_year_id"/>
                    </group>
                     <group string ="Details">
                        <field name="enrollment_date"/>
                        <field name="status"/>

                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- List View -->
    <record id="school_enrollment_view_list" model="ir.ui.view">
        <field name="name">school.enrollment.view.list</field>
        <field name="model">enrollment</field>
        <field name="arch" type="xml">
            <list string="School_enrollment">
                <field name="student_id"/>
                <field name="academic_year_id"/>
                <field name="class_id"/>
                <field name="enrollment_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>
    
    <!-- Action -->
    <record id="school_enrollment_action" model="ir.actions.act_window">
        <field name="name">School enrollment</field>
        <field name="res_model">enrollment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first school enrollment!
            </p>
        </field>
    </record>
    
    <!-- Menu -->
    <menuitem id="school_enrollment_menu"
              name="School enrollment"
              action="school_enrollment_action"
              parent="school_root_menu"
              sequence="3"/>
</odoo>